# Local development only. Change this value before starting PostgreSQL.
POSTGRES_DB=sevaai_manipur
POSTGRES_USER=sevaai
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# Backend connection from the host machine. Keep this password synchronized
# with POSTGRES_USER/POSTGRES_PASSWORD above; URL-encode reserved characters.
DATABASE_URL=postgresql+psycopg://sevaai:change_me_for_local_development@localhost:5432/sevaai_manipur

# Comma-separated browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial admin account; set ADMIN_PASSWORD in your ignored local .env file.
ADMIN_USER_ID=admin01
ADMIN_PASSWORD=

# Set to true when serving the frontend and API over HTTPS.
AUTH_COOKIE_SECURE=false
